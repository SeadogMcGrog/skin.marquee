<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>War Movies</name>
    <match>one</match>
    <rule field="genre" operator="is"><value>War</value></rule>
    <rule field="tag" operator="is"><value>military</value><value>Military</value><value>memorial day</value><value>Memorial Day</value><value>war</value><value>War</value></rule>
    <limit>60</limit>
    <order direction="ascending">random</order>
</smartplaylist>
