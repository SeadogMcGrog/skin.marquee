<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Military &amp; War TV</name>
    <match>one</match>
    <rule field="genre" operator="is"><value>War</value><value>War &amp; Politics</value><value>Military</value></rule>
    <limit>40</limit>
    <order direction="ascending">random</order>
</smartplaylist>
