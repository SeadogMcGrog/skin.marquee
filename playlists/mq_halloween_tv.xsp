<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="tvshows">
    <name>Creepy TV</name>
    <match>one</match>
    <rule field="genre" operator="is"><value>Horror</value><value>Sci-Fi &amp; Fantasy</value></rule>
    <limit>40</limit>
    <order direction="ascending">random</order>
</smartplaylist>
