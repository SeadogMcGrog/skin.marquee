<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="episodes">
    <name>Mother's Day Episodes</name>
    <match>one</match>
    <rule field="title" operator="contains"><value>Mother's Day</value><value>Mother</value></rule>
    <rule field="plot" operator="contains"><value>Mother's Day</value></rule>
    <limit>60</limit>
    <order direction="ascending">random</order>
</smartplaylist>
