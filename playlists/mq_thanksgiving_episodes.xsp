<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="episodes">
    <name>Thanksgiving Episodes</name>
    <match>one</match>
    <rule field="title" operator="contains"><value>Thanksgiving</value><value>Turkey</value><value>Pilgrim</value></rule>
    <rule field="plot" operator="contains"><value>Thanksgiving</value></rule>
    <limit>60</limit>
    <order direction="ascending">random</order>
</smartplaylist>
