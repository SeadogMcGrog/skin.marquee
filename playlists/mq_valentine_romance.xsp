<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Romance Movies</name>
    <match>one</match>
    <rule field="genre" operator="is"><value>Romance</value></rule>
    <rule field="tag" operator="is"><value>valentine</value><value>Valentine</value><value>romance</value><value>date night</value></rule>
    <limit>60</limit>
    <order direction="ascending">random</order>
</smartplaylist>
