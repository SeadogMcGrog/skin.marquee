<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Swashbucklers &amp; Adventure</name>
    <match>one</match>
    <rule field="genre" operator="is"><value>Adventure</value></rule>
    <limit>40</limit>
    <order direction="ascending">random</order>
</smartplaylist>
