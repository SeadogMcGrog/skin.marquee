<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="movies">
    <name>Movies for Dad</name>
    <match>one</match>
    <rule field="tag" operator="is"><value>dad</value><value>fathers day</value><value>Father's Day</value><value>father</value></rule>
    <rule field="title" operator="contains"><value>Father</value><value>Daddy</value><value>Big Fish</value><value>Field of Dreams</value></rule>
    <rule field="plot" operator="contains"><value>Father's Day</value></rule>
    <limit>60</limit>
    <order direction="ascending">random</order>
</smartplaylist>
