<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<smartplaylist type="episodes">
    <name>St. Patrick's Day Episodes</name>
    <match>one</match>
    <rule field="title" operator="contains"><value>St. Patrick</value><value>Leprechaun</value><value>Irish</value><value>Shamrock</value><value>Pot of Gold</value></rule>
    <rule field="plot" operator="contains"><value>St. Patrick</value></rule>
    <limit>60</limit>
    <order direction="ascending">random</order>
</smartplaylist>
